#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    chosen { zmk,physical-layout = &gggw_crosses_36_layout; };
};

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <
                5 6 7 8 9
                15 16 17 18 19
                25 26 27 28 29
                33 34 35
            >;

            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <
                0 1 2 3 4
                10 11 12 13 14
                20 21 22 23 24
                30 31 32
            >;

            hold-trigger-on-release;
        };
    };

    combos {
        compatible = "zmk,combos";

        // []

        lbracket {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <2 3>;
        };

        rbracket {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <7 6>;
        };

        // {}

        lbrace {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <4 3>;
        };

        rbrace {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <5 6>;
        };

        // {}

        lparens {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <1 2>;
        };

        rparens {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <7 8>;
        };

        backslash {
            bindings = <&kp BACKSLASH>;
            key-positions = <9 8>;
        };

        quote {
            bindings = <&kp SQT>;
            key-positions = <19 18>;
        };

        equals {
            bindings = <&kp EQUAL>;
            key-positions = <29 28>;
        };

        capsword {
            bindings = <&caps_word>;
            key-positions = <0 1>;
        };

        minus {
            bindings = <&kp MINUS>;
            key-positions = <10 11>;
        };

        grave {
            bindings = <&kp GRAVE>;
            key-positions = <20 21>;
        };

        layer7 {
            bindings = <&mo 7>;
            key-positions = <30 35>;
        };

        layer1 {
            bindings = <&to 0>;
            key-positions = <35 30>;
            layers = <7>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "BASE";
            bindings = <
              &kp B         &kp L        &kp D        &kp C                    &kp V    &kp J  &kp Y                &kp O        &kp U        &kp SEMICOLON
              &hml LCTRL N  &hml LALT R  &hml LGUI T  &hml LSHFT S             &kp G    &kp P  &hmr RSHFT H         &hmr RGUI A  &hmr RALT E  &hmr RCTRL I
              &kp X         &kp Q        &kp M        &hml LC(LS(LA(LGUI))) W  &kp Z    &kp K  &hmr LC(LS(LALT)) F  &kp COMMA    &kp PERIOD   &kp SLASH
                                         &lt 1 ESCAPE  &lt 2 SPACE              &lt 3 TAB    &lt 6 ENTER  &lt 5 BACKSPACE      &lt 4 ESCAPE
            >;
        };

        mouse_layer {
            display-name = "MOUSE";
            bindings = <
              &trans  &mkp RCLK        &mmv MOVE_UP    &mkp LCLK       &trans            &trans          &mkp LCLK       &mmv MOVE_UP    &mkp RCLK        &trans
              &trans  &mmv MOVE_RIGHT  &mmv MOVE_DOWN  &mmv MOVE_LEFT  &msc SCRL_UP      &msc SCRL_UP    &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans
              &trans  &msc SCRL_RIGHT  &mkp MCLK       &msc SCRL_LEFT  &msc SCRL_DOWN    &msc SCRL_DOWN  &msc SCRL_LEFT  &mkp MCLK       &msc SCRL_RIGHT  &trans
                                       &trans          &trans          &mo 8             &mo 8           &trans          &trans
            >;
        };

        number_layer {
            display-name = "NUMBER";
            bindings = <
              &trans  &trans  &trans  &trans  &trans    &kp PERCENT  &kp N7  &kp N8  &kp N9  &trans
              &trans  &trans  &trans  &trans  &trans    &kp SLASH    &kp N4  &kp N5  &kp N6  &kp PLUS
              &trans  &trans  &trans  &trans  &trans    &kp ASTRK    &kp N1  &kp N2  &kp N3  &kp MINUS
                              &trans  &trans  &trans    &kp EQUAL    &kp N0  &kp PERIOD
            >;
        };

        symbol_layer {
            display-name = "SYMBOL";
            bindings = <
              &trans  &trans  &trans  &trans  &trans    &trans  &kp AMPERSAND    &kp ASTERISK  &kp LA(NUMBER_2)  &trans
              &trans  &trans  &trans  &trans  &trans    &trans  &kp DOLLAR       &kp PERCENT   &kp CARET         &trans
              &trans  &trans  &trans  &trans  &trans    &trans  &kp EXCLAMATION  &kp AT_SIGN   &kp HASH          &trans
                              &trans  &trans  &trans    &trans  &trans           &trans
            >;
        };

        fw_rgb_layer {
            display-name = "FW_RGB";
            bindings = <
              &bt BT_SEL 4  &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0    &trans  &trans  &trans  &trans  &trans
              &trans        &trans        &trans        &trans        &bt BT_CLR      &trans  &trans  &trans  &trans  &trans
              &bootloader   &trans        &trans        &trans        &sys_reset      &trans  &trans  &trans  &trans  &bootloader
                                          &kp LSHFT     &trans        &kp SPACE       &trans  &trans  &trans
            >;
        };

        nav_layer {
            display-name = "NAV";
            bindings = <
              &trans  &trans                    &kp UP_ARROW    &trans                     &trans    &trans  &trans  &trans  &trans  &trans
              &trans  &kp LEFT                  &kp DOWN_ARROW  &kp RIGHT                  &trans    &trans  &trans  &trans  &trans  &trans
              &trans  &kp LG(LS(LEFT_BRACKET))  &trans          &kp LS(LG(RIGHT_BRACKET))  &trans    &trans  &trans  &trans  &trans  &trans
                                                &trans          &trans                     &trans    &trans  &trans  &trans
            >;
        };

        system_layer {
            display-name = "SYSTEM";
            bindings = <
              &trans  &trans  &kp C_BRIGHTNESS_INC  &kp C_VOLUME_UP    &kp C_NEXT          &trans  &trans  &trans  &trans  &trans
              &trans  &trans  &kp C_BRIGHTNESS_DEC  &kp C_VOLUME_DOWN  &kp C_PLAY_PAUSE    &trans  &trans  &trans  &trans  &trans
              &trans  &trans  &trans                &kp C_MUTE         &kp C_PREVIOUS      &trans  &trans  &trans  &trans  &trans
                              &trans                &trans             &trans              &trans  &trans  &trans
            >;
        };

        colemak_layer {
            display-name = "COLEMAK";
            bindings = <
              &kp Q         &kp W        &kp F        &kp P                    &kp G    &kp J  &kp L                &kp U        &kp Y        &kp SEMICOLON
              &hml LCTRL A  &hml LALT R  &hml LGUI S  &hml LSHFT T             &kp D    &kp H  &hmr RSHFT N         &hmr RGUI E  &hmr RALT I  &hmr RCTRL O
              &kp Z         &kp X        &kp C        &hml LC(LS(LA(LGUI))) V  &kp B    &kp K  &hmr LC(LS(LALT)) M  &kp COMMA    &kp PERIOD   &kp SLASH
                                         &to 0        &lt 2 SPACE              &lt 3 TAB    &lt 5 ENTER  &lt 4 BACKSPACE      &lt 1 ESCAPE
            >;
        };

        mouse_fast_layer {
            display-name = "MOUSE FAST";
            bindings = <
              &trans  &trans             &mmv MOVE_Y(-1200)  &trans              &trans    &trans  &trans              &mmv MOVE_Y(-1200)  &trans             &trans
              &trans  &mmv MOVE_X(1200)  &mmv MOVE_Y(1200)   &mmv MOVE_X(-1200)  &trans    &trans  &mmv MOVE_X(-1200)  &mmv MOVE_Y(1200)   &mmv MOVE_X(1200)  &trans
              &trans  &trans             &trans              &trans              &trans    &trans  &trans              &trans              &trans             &trans
                                         &trans              &trans              &trans    &trans  &trans              &trans
            >;
        };

        extra_layer_6 {
            display-name = "EXTRA 6";
            bindings = <
              &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
              &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
              &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
                              &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };
    };
};
