#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE 0
#define NAV 1
#define MEDIA 2
#define NUM 3
#define SYM 4
#define FUN 5
#define ADJUST 6

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <200>;
};

/ {
    chosen {
        zmk,physical-layout = &five_col_layout;
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            // --------------------------------------------------------------------------------------
            // |  Q  |  W  |  E  |  R  |  T  | MUTE | PLAY |  Y  |  U  |  I  |  O  |  P  |
            // | GUI/A | ALT/S | CTRL/D | SHIFT/F | G | ALT | ALT | H | SHIFT/J | CTRL/K | ALT/L | GUI/' |
            // |  Z  |  X  |  C  |  V  |  B  |             |  N  |  M  |  ,  |  .  |  /  |
            //              | ESC/MEDIA | SPACE/NAV | TAB/FUN | RET/SYM | BSPC/NUM | DEL/ADJ |
            bindings = <
                &kp Q       &kp W       &kp E        &kp R        &kp T &kp C_MUTE &kp C_PP &kp Y &kp U        &kp I        &kp O       &kp P
                &mt LGUI A  &mt LALT S  &mt LCTRL D  &mt LSHFT F  &kp G &kp LALT   &kp RALT &kp H &mt RSHFT J  &mt RCTRL K  &mt RALT L  &mt RGUI SQT
                &kp Z       &kp X       &kp C        &kp V        &kp B                     &kp N &kp M        &kp COMMA    &kp DOT     &kp FSLH
                                              &lt MEDIA ESC &lt NAV SPACE &lt FUN TAB      &lt SYM RET &lt NUM BSPC &lt ADJUST DEL
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_UP PG_DN &inc_dec_kp C_PREV C_NEXT &inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        nav_layer {
            display-name = "NAV";
            // --------------------------------------------------------------------------------
            // |     |     |      |       |     |      |      |      |      |      |      |      |
            // | GUI | ALT | CTRL | SHIFT |     | ALT  | ALT  | CAPS | LEFT | DOWN |  UP  | RIGHT|
            // |     |     |      |       |     |             | INS  | HOME | PGDN | PGUP | END  |
            //                       |     |     |     |             |     |     |     |
            bindings = <
                &none      &none      &none       &none       &none &trans   &trans   &none    &none      &none       &none       &none
                &kp LGUI   &kp LALT   &kp LCTRL   &kp LSHFT   &none &kp LALT &kp RALT &kp CAPS &kp LEFT   &kp DOWN    &kp UP      &kp RIGHT
                &none      &none      &none       &none       &none                   &kp INS  &kp HOME   &kp PG_DN   &kp PG_UP   &kp END
                                                &trans &trans &trans                  &trans &trans &trans
            >;
        };

        media_layer {
            display-name = "MEDIA";
            // --------------------------------------------------------------------------------------
            // | HUD | HUI | SAD | SAI | EFF | MUTE | PLAY | EFF | SAI | SAD | HUI | HUD |
            // | PREV| VOLD| MUTE| VOLU| NEXT| ALT  | ALT  | PREV| VOLD| MUTE| VOLU| NEXT|
            // | BRI | BRD | TOG |     |     |            |     |     | TOG | BRD | BRI |
            //                       |     |     |     |         |     |     |     |
            bindings = <
                &rgb_ug RGB_HUD &rgb_ug RGB_HUI &rgb_ug RGB_SAD &rgb_ug RGB_SAI &rgb_ug RGB_EFF &kp C_MUTE &kp C_PP &rgb_ug RGB_EFF &rgb_ug RGB_SAI &rgb_ug RGB_SAD &rgb_ug RGB_HUI &rgb_ug RGB_HUD
                &kp C_PREV      &kp C_VOL_DN    &kp C_MUTE      &kp C_VOL_UP    &kp C_NEXT      &kp LALT   &kp RALT &kp C_PREV      &kp C_VOL_DN    &kp C_MUTE      &kp C_VOL_UP    &kp C_NEXT
                &rgb_ug RGB_BRI &rgb_ug RGB_BRD &rgb_ug RGB_TOG &none           &none                                  &none           &none           &rgb_ug RGB_TOG &rgb_ug RGB_BRD &rgb_ug RGB_BRI
                                                                 &trans &trans &trans                                &trans &trans &trans
            >;
        };

        num_layer {
            display-name = "NUM";
            // --------------------------------------------------------------------------------
            // |  [  |  7  |  8  |  9  |  ]  |      |      |     |       |      |     |     |
            // |  ;  |  4  |  5  |  6  |  =  |      |      |     | SHIFT | CTRL | ALT | GUI |
            // |  `  |  1  |  2  |  3  |  \  |             |     |       |      |     |     |
            //                       |  .  |  0  |  -  |          |     |     |     |
            bindings = <
                &kp LBKT   &kp N7   &kp N8    &kp N9   &kp RBKT  &trans &trans &none &none      &none      &none     &none
                &kp SEMI   &kp N4   &kp N5    &kp N6   &kp EQUAL &trans &trans &none &kp RSHFT  &kp RCTRL  &kp RALT  &kp RGUI
                &kp GRAVE  &kp N1   &kp N2    &kp N3   &kp BSLH                &none &none      &none      &none     &none
                                           &kp DOT &kp N0 &kp MINUS            &trans &trans &trans
            >;
        };

        sym_layer {
            display-name = "SYM";
            // --------------------------------------------------------------------------------
            // |  {  |  &  |  *  |  (  |  }  |      |      |     |       |      |     |     |
            // |  :  |  $  |  %  |  ^  |  +  |      |      |     | SHIFT | CTRL | ALT | GUI |
            // |  ~  |  !  |  @  |  #  |  |  |             |     |       |      |     |     |
            //                       |  (  |  )  |  _  |          |     |     |     |
            bindings = <
                &kp LBRC   &kp AMPS  &kp ASTRK  &kp LPAR  &kp RBRC &trans &trans &none &none      &none      &none     &none
                &kp COLON  &kp DLLR  &kp PRCNT  &kp CARET &kp PLUS &trans &trans &none &kp RSHFT  &kp RCTRL  &kp RALT  &kp RGUI
                &kp TILDE  &kp EXCL  &kp AT     &kp HASH  &kp PIPE               &none &none      &none      &none     &none
                                              &kp LPAR &kp RPAR &kp UNDER         &trans &trans &trans
            >;
        };

        fun_layer {
            display-name = "FUN";
            // --------------------------------------------------------------------------------
            // |     |     |      |       |     |      |      | PSCR| F7 | F8 | F9 | F12|
            // | GUI | ALT | CTRL | SHIFT |     | ALT  | ALT  | SLCK| F4 | F5 | F6 | F11|
            // |     |     |      |       |     |             | PAUS| F1 | F2 | F3 | F10|
            //                       |     |     |     |             |     |     |     |
            bindings = <
                &none      &none      &none       &none       &none &trans   &trans   &kp PSCRN       &kp F7 &kp F8 &kp F9 &kp F12
                &kp LGUI   &kp LALT   &kp LCTRL   &kp LSHFT   &none &kp LALT &kp RALT &kp SLCK        &kp F4 &kp F5 &kp F6 &kp F11
                &none      &none      &none       &none       &none                   &kp PAUSE_BREAK &kp F1 &kp F2 &kp F3 &kp F10
                                                &trans &trans &trans                  &trans &trans &trans
            >;
        };

        adjust_layer {
            display-name = "ADJUST";
            // --------------------------------------------------------------------------------
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | MUTE | PLAY | BT5 |     |     |     |     |
            // | HUD | HUI | SAD | SAI | EFF | ALT  | ALT  | BRI | BRD | TOG |     |     |
            // | RST | BOOT| UNLK|     |     |            |     |     |     |     |     |
            //                       |     |     |     |         |     |     |     |
            bindings = <
                &bt BT_CLR       &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &kp C_MUTE &kp C_PP &bt BT_SEL 4     &none             &none             &none         &none
                &rgb_ug RGB_HUD  &rgb_ug RGB_HUI &rgb_ug RGB_SAD &rgb_ug RGB_SAI &rgb_ug RGB_EFF &kp LALT   &kp RALT &rgb_ug RGB_BRI &rgb_ug RGB_BRD   &rgb_ug RGB_TOG   &none         &none
                &sys_reset       &bootloader      &studio_unlock  &none           &none                                  &none             &none             &none             &none         &none
                                                                 &trans &trans &trans                                  &trans &trans &trans
            >;
        };

        extra_layer_1 {
            display-name = "EXTRA 1";
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans
                              &trans &trans &trans               &trans &trans &trans
            >;
        };

        extra_layer_2 {
            display-name = "EXTRA 2";
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans
                              &trans &trans &trans               &trans &trans &trans
            >;
        };
    };
};
